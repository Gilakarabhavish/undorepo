docker-compose.yml

yaml
version: '3.8'

networks:
  app-network:
    driver: bridge

volumes:
  postgres_data:
  mongo_data:

services:
  postgres-db:
    image: postgres:16-alpine
    container_name: local-postgres
    environment:
      POSTGRES_USER: dev_user
      POSTGRES_PASSWORD: dev_password
      POSTGRES_DB: core_db
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - app-network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U dev_user -d core_db"]
      interval: 5s
      timeout: 5s
      retries: 5

  mongo-db:
    image: mongo:7.0
    container_name: local-mongo
    environment:
      MONGO_INITDB_ROOT_USERNAME: admin
      MONGO_INITDB_ROOT_PASSWORD: admin_password
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db
    networks:
      - app-network
    healthcheck:
      test: echo 'db.runCommand("ping").ok' | mongosh localhost:27017/test --quiet
      interval: 5s
      timeout: 5s
      retries: 5

  backend-api:
    build:
      context: ./backend
      dockerfile: Dockerfile.backend
    container_name: local-api
    environment:
      PORT: 5000
      DATABASE_URL: postgres://dev_user:dev_password@postgres-db:5432/core_db
      MONGO_URI: mongodb://admin:admin_password@mongo-db:27017/logs?authSource=admin
      CORS_ORIGIN: http://localhost:80
    ports:
      - "5000:5000"
    depends_on:
      postgres-db:
        condition: service_healthy
      mongo-db:
        condition: service_healthy
    networks:
      - app-network

  frontend-app:
    build:
      context: ./frontend
      dockerfile: Dockerfile.frontend
      args:
        VITE_API_URL: http://localhost:5000
    container_name: local-frontend
    ports:
      - "80:80"
    depends_on:
      - backend-api
    networks:
      - app-network
